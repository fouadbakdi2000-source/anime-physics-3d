<?xml version='1.0' encoding='utf-8'?>
<widget id="com.verdroid.animephysics" version="1.0.0"
        xmlns="http://www.w3.org/ns/widgets"
        xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Anime Physics Studio</name>
    <description>Anime Physics Studio 3D - WebGL character with physics</description>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xff0b0d16" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="34" />
    <platform name="android">
        <icon src="www/icon.png" />
    </platform>
</widget>